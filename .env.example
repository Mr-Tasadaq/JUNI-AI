# Required for real model responses
OPENAI_API_KEY=

# Optional model override; defaults to gpt-5.5
OPENAI_MODEL=gpt-5.5

# Required for API access control. Use a long random value.
JUNI_API_TOKEN=

# Rate limiting: requests per window per client
JUNI_RATE_LIMIT=20
JUNI_RATE_WINDOW_SECONDS=60

# Optional: if configured, a distributed rate limiter can be added later.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
