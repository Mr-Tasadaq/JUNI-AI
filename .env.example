# Provider API keys (server-only; never put these in frontend code)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Provider model defaults
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-5.5
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# Provider operation timeouts
ANTHROPIC_TIMEOUT_MS=30000
OPENAI_TIMEOUT_MS=30000
GEMINI_TIMEOUT_MS=30000

# Enable/disable providers
JUNI_PROVIDER_ANTHROPIC_ENABLED=true
JUNI_PROVIDER_OPENAI_ENABLED=true
JUNI_PROVIDER_GEMINI_ENABLED=true

# Core routing
JUNI_DEFAULT_PROVIDER=openai
JUNI_DEFAULT_MODEL=
JUNI_PROVIDER_PRIORITY=openai,anthropic,gemini
JUNI_FALLBACK_PROVIDERS=anthropic,gemini
JUNI_MAX_PROVIDER_RETRIES=1
JUNI_PROVIDER_RETRY_DELAY_MS=250

# Core feature flags
JUNI_FEATURE_MULTIMODAL=true
JUNI_FEATURE_STREAMING=true
JUNI_FEATURE_TOOLS=true
JUNI_FEATURE_WEB_RESEARCH=false
JUNI_FEATURE_VOICE=false

# Request identity
JUNI_IDENTITY_DEFAULT_TENANT_ID=
JUNI_IDENTITY_DEFAULT_USER_ID=
JUNI_IDENTITY_ALLOW_HEADERS=false

# Security
JUNI_API_TOKEN=
JUNI_ALLOWED_ORIGIN=
# Production deployments must set this to the exact HTTPS origin serving the app.
JUNI_AUTH_COOKIE_NAME=juni_auth
JUNI_AUTH_COOKIE_MAX_AGE_SECONDS=2592000
JUNI_AUTH_RATE_LIMIT=5
JUNI_AUTH_RATE_WINDOW_SECONDS=300
JUNI_MAX_MESSAGE_LENGTH=4000
JUNI_MAX_HISTORY=20

# Client-selectable provider/model allowlist.
JUNI_REQUEST_ALLOWED_PROVIDERS=openai,anthropic,gemini
# Example:
# JUNI_REQUEST_ALLOWED_MODELS_JSON={"openai":["gpt-5.5","gpt-5.4"],"anthropic":["claude-opus-5"],"gemini":["gemini-3.8-flash"]}

# Answer-First
JUNI_ANSWER_FIRST_ENABLED=true
JUNI_ANSWER_FIRST_SEMANTIC_THRESHOLD=0.92

# Agent tools
JUNI_TOOLS_ENABLED=true
JUNI_TOOL_MAX_EXECUTION_MS=15000
JUNI_TOOL_MAX_RESULT_BYTES=64000
JUNI_TOOL_REQUIRE_APPROVAL_FOR_MUTATIONS=true

# Observability/provenance
JUNI_METRICS_MAX_SAMPLES=500
JUNI_MAX_EVENT_PAYLOAD_BYTES=8192
JUNI_STORAGE_BUDGET_BYTES=10737418240
JUNI_STORAGE_ENABLED=true
# Production should use a hosted/remote LibSQL-compatible database for durable serverless state.
JUNI_STORAGE_REQUIRED=true
JUNI_DATABASE_URL=file:juni.db
JUNI_DATABASE_AUTH_TOKEN=
JUNI_STORAGE_WARNING_THRESHOLDS=0.8,0.9

# Retention
JUNI_RETENTION_TRANSIENT_DAYS=1
JUNI_RETENTION_LOGS_DAYS=30
JUNI_RETENTION_CACHE_DAYS=7
JUNI_RETENTION_MEDIA_DAYS=365
JUNI_RETENTION_CONVERSATION_DAYS=90
JUNI_RETENTION_MEMORY_DAYS=0
JUNI_RETENTION_RESEARCH_DAYS=30

# Request limiter
JUNI_RATE_LIMIT=20
JUNI_RATE_WINDOW_SECONDS=60

# Controlled web research
JUNI_RESEARCH_MAX_SOURCES=8
JUNI_RESEARCH_MAX_SEARCH_QUERIES=3
JUNI_RESEARCH_MAX_RETRIEVED_BYTES=5242880
JUNI_RESEARCH_MAX_SOURCE_BYTES=524288
JUNI_RESEARCH_MAX_REDIRECTS=3
JUNI_RESEARCH_MAX_CONCURRENT_RETRIEVALS=3
JUNI_RESEARCH_RETRIEVAL_TIMEOUT_MS=12000
JUNI_RESEARCH_PROVIDER_TIMEOUT_MS=60000
JUNI_RESEARCH_CACHE_TTL_SECONDS=900
JUNI_RESEARCH_USER_AGENT=JUNI-AI-Research/1.0
JUNI_RESEARCH_ALLOWED_DOMAINS=
JUNI_RESEARCH_BLOCKED_DOMAINS=
JUNI_OPENAI_SEARCH_TOOL_TYPE=web_search
JUNI_GEMINI_SEARCH_TOOL_TYPE=google_search
JUNI_GEMINI_URL_CONTEXT_TOOL_TYPE=url_context
JUNI_ANTHROPIC_WEB_SEARCH_TOOL_TYPE=web_search_20260318
JUNI_RESEARCH_DEFAULT_TENANT_ID=
JUNI_RESEARCH_DEFAULT_USER_ID=
JUNI_RESEARCH_ALLOW_IDENTITY_HEADERS=false

# Answer-First semantic lookup
JUNI_ANSWER_FIRST_EMBEDDING_MODEL=text-embedding-3-small

# Approved-answer GitHub export
JUNI_APPROVED_ANSWER_EXPORT_ENABLED=false
JUNI_GITHUB_TOKEN=
JUNI_EXPORT_TENANT_ID=
JUNI_EXPORT_USER_ID=
JUNI_GITHUB_BRANCH=main
JUNI_GITHUB_INDEX_PATH=data/approved-answers.json
JUNI_EXPORT_BATCH_SIZE=50
JUNI_GITHUB_MAX_RETRIES=3
